{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/ModuleOutput"
    },
    {
      "properties": {
        "module_key": {
          "const": "invoice_integrity"
        },
        "ai_score": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  ]
}
