{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ModuleKey": {
      "type": "string",
      "enum": [
        "invoice_integrity",
        "buyer_verification",
        "seller_verification",
        "relationship",
        "market_price",
        "payment_history",
        "duplicate_financing"
      ]
    },
    "RiskBand": {
      "type": "string",
      "enum": [
        "LOW",
        "HIGH"
      ]
    },
    "SourceRef": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "user_pdf",
            "user_xlsx",
            "authored_demo_seed",
            "uploaded_file",
            "analyst_statement"
          ]
        }
      },
      "required": [
        "source_id",
        "locator",
        "kind"
      ],
      "additionalProperties": false
    },
    "PartySelection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "skip"
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "existing"
            },
            "entity_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "mode",
            "entity_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "manual"
            },
            "legal_name": {
              "type": "string",
              "minLength": 1
            },
            "country": {
              "type": "string",
              "minLength": 1
            },
            "tax_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "mode",
            "legal_name"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Party": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "legal_name": {
          "type": "string",
          "minLength": 1
        },
        "tax_id": {
          "type": "string",
          "minLength": 1
        },
        "country": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "entity_id",
        "legal_name",
        "tax_id",
        "country",
        "address"
      ],
      "additionalProperties": false
    },
    "LineItem": {
      "type": "object",
      "properties": {
        "sku": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "unit_price": {
          "type": "string",
          "pattern": "^\\d+\\.\\d{2}$"
        },
        "line_total": {
          "type": "string",
          "pattern": "^\\d+\\.\\d{2}$"
        },
        "hs_code": {
          "type": "string",
          "minLength": 1
        },
        "country_of_manufacture": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "sku",
        "description",
        "quantity",
        "unit",
        "unit_price",
        "line_total",
        "hs_code",
        "country_of_manufacture"
      ],
      "additionalProperties": false
    },
    "Invoice": {
      "type": "object",
      "properties": {
        "invoice_id": {
          "type": "string",
          "minLength": 1
        },
        "invoice_number": {
          "type": "string",
          "minLength": 1
        },
        "invoice_date": {
          "type": "string",
          "format": "date"
        },
        "ship_date": {
          "type": "string",
          "format": "date"
        },
        "due_date": {
          "type": "string",
          "format": "date"
        },
        "payment_terms": {
          "type": "string",
          "minLength": 1
        },
        "payment_term_days": {
          "type": "integer",
          "minimum": 1
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "seller": {
          "$ref": "#/$defs/Party"
        },
        "buyer": {
          "$ref": "#/$defs/Party"
        },
        "consignee_same_as_buyer": {
          "type": "boolean"
        },
        "declared_related": {
          "type": "boolean"
        },
        "purchase_order_number": {
          "type": "string",
          "minLength": 1
        },
        "air_waybill_number": {
          "type": "string",
          "minLength": 1
        },
        "line_items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LineItem"
          },
          "minItems": 1
        },
        "subtotal": {
          "type": "string",
          "pattern": "^\\d+\\.\\d{2}$"
        },
        "charges": {
          "type": "object",
          "properties": {
            "insurance": {
              "type": "string",
              "pattern": "^\\d+\\.\\d{2}$"
            },
            "freight": {
              "type": "string",
              "pattern": "^\\d+\\.\\d{2}$"
            },
            "packing": {
              "type": "string",
              "pattern": "^\\d+\\.\\d{2}$"
            },
            "handling": {
              "type": "string",
              "pattern": "^\\d+\\.\\d{2}$"
            },
            "other": {
              "type": "string",
              "pattern": "^\\d+\\.\\d{2}$"
            }
          },
          "required": [
            "insurance",
            "freight",
            "packing",
            "handling",
            "other"
          ],
          "additionalProperties": false
        },
        "total": {
          "type": "string",
          "pattern": "^\\d+\\.\\d{2}$"
        },
        "trade_terms": {
          "type": "string",
          "minLength": 1
        },
        "delivery_location": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 1
        },
        "extraction_method": {
          "type": "string",
          "enum": [
            "acroform_verified",
            "verified_form_fixture",
            "text",
            "ocr"
          ]
        },
        "synthetic": {
          "type": "boolean"
        }
      },
      "required": [
        "invoice_id",
        "invoice_number",
        "invoice_date",
        "ship_date",
        "due_date",
        "payment_terms",
        "payment_term_days",
        "currency",
        "seller",
        "buyer",
        "consignee_same_as_buyer",
        "declared_related",
        "purchase_order_number",
        "air_waybill_number",
        "line_items",
        "subtotal",
        "charges",
        "total",
        "trade_terms",
        "delivery_location",
        "source_refs",
        "extraction_method",
        "synthetic"
      ],
      "additionalProperties": false
    },
    "ReferenceRecord": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "synthetic": {
          "type": "boolean"
        },
        "source_type": {
          "const": "authored_demo_seed"
        },
        "as_of": {
          "type": "string",
          "format": "date"
        },
        "data": {
          "type": "object"
        }
      },
      "required": [
        "source_id",
        "kind",
        "synthetic",
        "source_type",
        "as_of",
        "data"
      ],
      "additionalProperties": false
    },
    "Supplement": {
      "type": "object",
      "properties": {
        "supplement_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "author_id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_ref": {
          "$ref": "#/$defs/SourceRef"
        }
      },
      "required": [
        "supplement_id",
        "text",
        "author_id",
        "created_at",
        "source_ref"
      ],
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "file",
            "reference"
          ]
        },
        "file_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "filename": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "parse_status": {
          "type": "string",
          "enum": [
            "pending",
            "ready",
            "failed"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "withdrawn"
          ]
        },
        "source_ref": {
          "$ref": "#/$defs/SourceRef"
        }
      },
      "required": [
        "evidence_id",
        "source_id",
        "kind",
        "file_id",
        "filename",
        "sha256",
        "parse_status",
        "status",
        "source_ref"
      ],
      "additionalProperties": false
    },
    "ModuleInput": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "module_key": {
          "$ref": "#/$defs/ModuleKey"
        },
        "input_version": {
          "type": "integer",
          "minimum": 1
        },
        "as_of": {
          "type": "string",
          "format": "date"
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "facts": {
          "type": "object"
        },
        "reference_records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReferenceRecord"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "supplements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Supplement"
          }
        }
      },
      "required": [
        "case_id",
        "module_key",
        "input_version",
        "as_of",
        "policy_version",
        "facts",
        "reference_records",
        "evidence",
        "supplements"
      ],
      "additionalProperties": false
    },
    "Finding": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "code",
        "statement",
        "source_refs",
        "confidence"
      ],
      "additionalProperties": false
    },
    "Provenance": {
      "type": "object",
      "properties": {
        "engine_mode": {
          "type": "string",
          "enum": [
            "demo_replay",
            "llm"
          ]
        },
        "analyzer": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "prompt_version": {
          "type": "string",
          "minLength": 1
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "parser_version": {
          "type": "string",
          "minLength": 1
        },
        "input_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "engine_mode",
        "analyzer",
        "model",
        "prompt_version",
        "policy_version",
        "parser_version",
        "input_hash",
        "generated_at"
      ],
      "additionalProperties": false
    },
    "ModuleOutput": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "module_key": {
          "$ref": "#/$defs/ModuleKey"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "input_version": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "succeeded",
            "needs_info"
          ]
        },
        "ai_score": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          }
        },
        "matched_rule_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "blocking_flags": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "confirmed_duplicate_financing",
              "entity_mismatch",
              "invoice_integrity_conflict"
            ]
          },
          "uniqueItems": true
        },
        "missing_inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "case_id",
        "module_key",
        "run_id",
        "input_version",
        "state",
        "ai_score",
        "summary",
        "findings",
        "matched_rule_ids",
        "blocking_flags",
        "missing_inputs",
        "provenance"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "succeeded"
              }
            }
          },
          "then": {
            "properties": {
              "ai_score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "missing_inputs": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "ai_score": {
                "type": "null"
              },
              "missing_inputs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "RunHistoryItem": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "input_version": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "succeeded",
            "needs_info",
            "failed",
            "superseded"
          ]
        },
        "ai_score": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "run_id",
        "input_version",
        "status",
        "ai_score",
        "created_at",
        "finished_at"
      ],
      "additionalProperties": false
    },
    "ModuleView": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "module_key": {
          "$ref": "#/$defs/ModuleKey"
        },
        "cap": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "module_version": {
          "type": "integer",
          "minimum": 1
        },
        "input_version": {
          "type": "integer",
          "minimum": 1
        },
        "evaluated_input_version": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "not_started",
            "queued",
            "running",
            "succeeded",
            "needs_info",
            "failed"
          ]
        },
        "freshness": {
          "type": "string",
          "enum": [
            "none",
            "current",
            "stale"
          ]
        },
        "adjustment_status": {
          "type": "string",
          "enum": [
            "none",
            "active",
            "pending_review"
          ]
        },
        "current_run": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModuleOutput"
            },
            {
              "type": "null"
            }
          ]
        },
        "requested_adjustment": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100
        },
        "effective_adjustment": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100
        },
        "final_score": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "allowed_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "upload_evidence",
              "save_information",
              "save_and_rerun",
              "rerun",
              "adjust",
              "full_view"
            ]
          },
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "supplements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Supplement"
          }
        },
        "run_history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RunHistoryItem"
          }
        },
        "manual_adjustments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ManualAdjustment"
          }
        }
      },
      "required": [
        "case_id",
        "module_key",
        "cap",
        "module_version",
        "input_version",
        "evaluated_input_version",
        "state",
        "freshness",
        "adjustment_status",
        "current_run",
        "requested_adjustment",
        "effective_adjustment",
        "final_score",
        "allowed_actions",
        "evidence",
        "supplements",
        "run_history",
        "manual_adjustments"
      ],
      "additionalProperties": false
    },
    "ManualAdjustment": {
      "type": "object",
      "properties": {
        "adjustment_id": {
          "type": "string",
          "minLength": 1
        },
        "applies_to_run_id": {
          "type": "string",
          "minLength": 1
        },
        "requested_adjustment": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100
        },
        "effective_adjustment": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "pending_review",
            "superseded"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "adjustment_id",
        "applies_to_run_id",
        "requested_adjustment",
        "effective_adjustment",
        "reason",
        "actor_id",
        "status",
        "created_at"
      ],
      "additionalProperties": false
    },
    "Decision": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "eligible",
            "manual_review",
            "pending"
          ]
        },
        "advance_rate": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "advance_amount": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d+\\.\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "status",
        "advance_rate",
        "advance_amount",
        "currency",
        "reasons"
      ],
      "additionalProperties": false
    },
    "ScoreSnapshot": {
      "type": "object",
      "properties": {
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "aggregate_revision": {
          "type": "integer",
          "minimum": 1
        },
        "ai_total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "effective_adjustment_total": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100
        },
        "final_risk_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "risk_band": {
