APEX_DATA_DIR=./runtime
APEX_HOST=127.0.0.1
APEX_PORT=18080
APEX_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# TeamRouter configuration lives only in the backend. No automatic provider/model fallback.
TEAMROUTER_BASE_URL=https://api.teamorouter.com/v1
TEAMROUTER_API_KEY=
TEAMROUTER_MODEL=gpt-6.1-sol
TEAMROUTER_API_STYLE=chat
TEAMROUTER_TIMEOUT_SECONDS=90
